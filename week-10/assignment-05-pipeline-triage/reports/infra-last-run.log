trigger:
  branches:
    include:
    - main
  paths:
    include:
    - terraform/*
    - azure-pipelines.yml
pr:
  enabled: false
variables:
- group: Epicbook-aws-secrets
- group: Epicbook-mysql-secrets
- name: terraformVersion
  value: "1.17.1"
- name: awsDefaultRegion
  value: "eu-north-1"
- name: tfStateBucket
  value: "epicbook-tfstate-21382"
- name: tfStateKey
  value: "epicbook.terraform.tfstate"
- name: tfStateRegion
  value: "eu-north-1"
- name: tfStateLockTable
  value: "epicbook-tfstate-lock"
stages:
- stage: Validate
  displayName: "Stage 1 - Validate"
  jobs:
  - job: Validate
    displayName: "Format check and validate"
    pool:
      vmImage: ubuntu-latest
    steps:
    - task: 6d15af64-176c-496d-b583-fd2ae21d4df4@1
      displayName: "Checkout repository"
      inputs:
        repository: self
    - task: CmdLine@2
      displayName: "Install Terraform $(terraformVersion)"
      inputs:
        script: |
          set -euo pipefail
          # Clear any leftovers in this temp directory. The step runs here, not in
          # the repo checkout, so `rm -rf terraform` cannot touch the Terraform code.
          rm -rf terraform terraform.zip tf_install
          curl -fsSL https://releases.hashicorp.com/terraform/$(terraformVersion)/terraform_$(terraformVersion)_linux_amd64.zip -o terraform.zip
          mkdir tf_install
          unzip -o terraform.zip -d tf_install
          sudo mv tf_install/terraform /usr/local/bin/terraform
          rm -rf tf_install terraform.zip
          terraform version
        workingDirectory: $(Agent.TempDirectory)
    - task: CmdLine@2
      displayName: "Terraform init (backend config)"
      env:
        AWS_ACCESS_KEY_ID: $(awsAccessKeyId)
        AWS_SECRET_ACCESS_KEY: [REDACTED]
        AWS_DEFAULT_REGION: $(awsDefaultRegion)
      inputs:
        script: |
          set -euo pipefail
          terraform init -input=false \
            -backend-config="bucket=$(tfStateBucket)" \
            -backend-config="key=$(tfStateKey)" \
            -backend-config="region=$(tfStateRegion)" \
            -backend-config="dynamodb_table=$(tfStateLockTable)"
        workingDirectory: terraform
    - task: CmdLine@2
      displayName: "Terraform fmt check"
      inputs:
        script: |
          set -euo pipefail
          if ! terraform fmt -check -recursive; then
            echo "##[error]terraform fmt found unformatted files. Run 'terraform fmt -recursive' locally, then commit the result."
            exit 1
          fi
        workingDirectory: terraform
    - task: CmdLine@2
      displayName: "Terraform validate"
      env:
        AWS_ACCESS_KEY_ID: $(awsAccessKeyId)
        AWS_SECRET_ACCESS_KEY: [REDACTED]
        AWS_DEFAULT_REGION: $(awsDefaultRegion)
      inputs:
        script: |
          set -euo pipefail
          if ! terraform validate; then
            echo "##[error]terraform validate failed. See the errors above."
            exit 1
          fi
        workingDirectory: terraform
- stage: Plan
  displayName: "Stage 2 - Plan"
  dependsOn:
  - Validate
  jobs:
  - job: Plan
    displayName: "Terraform plan"
    pool:
      vmImage: ubuntu-latest
    steps:
    - task: 6d15af64-176c-496d-b583-fd2ae21d4df4@1
      displayName: "Checkout repository"
      inputs:
        repository: self
    - task: DownloadSecureFile@1
      name: fetchTfvars
      displayName: "Download terraform.tfvars"
      inputs:
        secureFile: "terraform.tfvars"
    - task: CmdLine@2
      displayName: "Place terraform.tfvars"
      inputs:
        script: |
          set -euo pipefail
          cp "$(fetchTfvars.secureFilePath)" terraform/terraform.tfvars
          chmod 600 terraform/terraform.tfvars
    - task: CmdLine@2
      displayName: "Install Terraform"
      inputs:
        script: |
          set -euo pipefail
          curl -fsSL \
            "https://releases.hashicorp.com/terraform/$(terraformVersion)/terraform_$(terraformVersion)_linux_amd64.zip" \
            -o terraform.zip

          mkdir -p tf_install
          unzip -o terraform.zip -d tf_install
          sudo mv tf_install/terraform /usr/local/bin/terraform

          rm -rf tf_install terraform.zip
          terraform version
        workingDirectory: $(Agent.TempDirectory)
    - task: CmdLine@2
      displayName: "Terraform init"
      env:
        AWS_ACCESS_KEY_ID: $(awsAccessKeyId)
        AWS_SECRET_ACCESS_KEY: [REDACTED]
        AWS_DEFAULT_REGION: $(awsDefaultRegion)
      inputs:
        script: |
          set -euo pipefail

          terraform init -input=false \
            -backend-config="bucket=$(tfStateBucket)" \
            -backend-config="key=$(tfStateKey)" \
            -backend-config="region=$(tfStateRegion)" \
            -backend-config="dynamodb_table=$(tfStateLockTable)"
        workingDirectory: terraform
    - task: CmdLine@2
      displayName: "Terraform plan"
      env:
        AWS_ACCESS_KEY_ID: $(awsAccessKeyId)
        AWS_SECRET_ACCESS_KEY: [REDACTED]
        AWS_DEFAULT_REGION: $(awsDefaultRegion)
        TF_VAR_db_admin_username: $(dbAdminUsername)
        TF_VAR_db_admin_password: [REDACTED]
      inputs:
        script: |
          set -euo pipefail

          terraform validate

          terraform plan \
            -input=false \
            -var-file="terraform.tfvars" \
            -out=tfplan
        workingDirectory: terraform
    - task: PublishPipelineArtifact@1
      displayName: "Publish Terraform plan"
      inputs:
        targetPath: "$(System.DefaultWorkingDirectory)/terraform/tfplan"
        artifact: "tfplan"
        publishLocation: "pipeline"
- stage: Apply
  displayName: "Stage 3 - Apply"
  dependsOn:
  - Plan
  jobs:
  - deployment: Apply
    displayName: "Apply the saved plan"
    pool:
      vmImage: ubuntu-latest
    environment:
      name: epicbook-infra-approval
    strategy:
      runOnce:
        deploy:
          steps:
          - task: 6d15af64-176c-496d-b583-fd2ae21d4df4@1
            displayName: "Checkout repository"
            inputs:
              repository: self
          - task: 30f35852-3f7e-4c0c-9a88-e127b4f97211@1
            displayName: "Download tfplan artifact"
            inputs:
              alias: current
              artifact: tfplan
          - task: CmdLine@2
            displayName: "Place tfplan in the working directory"
            inputs:
              script: |
                set -euo pipefail
                cp "$(Pipeline.Workspace)/tfplan/tfplan" "$(System.DefaultWorkingDirectory)/terraform/tfplan"
          - task: CmdLine@2
            displayName: "Install Terraform $(terraformVersion)"
            inputs:
              script: |
                set -euo pipefail
                # Clear any leftovers in this temp directory. The step runs here, not in
                # the repo checkout, so `rm -rf terraform` cannot touch the Terraform code.
                rm -rf terraform terraform.zip tf_install
                curl -fsSL https://releases.hashicorp.com/terraform/$(terraformVersion)/terraform_$(terraformVersion)_linux_amd64.zip -o terraform.zip
                mkdir tf_install
                unzip -o terraform.zip -d tf_install
                sudo mv tf_install/terraform /usr/local/bin/terraform
                rm -rf tf_install terraform.zip
                terraform version
              workingDirectory: $(Agent.TempDirectory)
          - task: CmdLine@2
            displayName: "Terraform init (backend config)"
            env:
              AWS_ACCESS_KEY_ID: $(awsAccessKeyId)
              AWS_SECRET_ACCESS_KEY: [REDACTED]
              AWS_DEFAULT_REGION: $(awsDefaultRegion)
            inputs:
              script: |
                set -euo pipefail
                terraform init -input=false \
                  -backend-config="bucket=$(tfStateBucket)" \
                  -backend-config="key=$(tfStateKey)" \
                  -backend-config="region=$(tfStateRegion)" \
                  -backend-config="dynamodb_table=$(tfStateLockTable)"
              workingDirectory: terraform
          - task: CmdLine@2
            displayName: "Terraform apply saved plan"
            env:
              AWS_ACCESS_KEY_ID: $(awsAccessKeyId)
              AWS_SECRET_ACCESS_KEY: [REDACTED]
              AWS_DEFAULT_REGION: $(awsDefaultRegion)
            inputs:
              script: |
                set -euo pipefail
                terraform apply -input=false tfplan
              workingDirectory: terraform
          - task: CmdLine@2
            condition: failed()
            displayName: "On failure: where to find the apply error"
            inputs:
              script: |
                echo "##[error]Terraform apply FAILED. The real error is in the 'Terraform apply saved plan' step log above, not in this step."
- stage: Outputs
  displayName: "Stage 4 - Outputs"
  dependsOn:
  - Apply
  jobs:
  - job: Outputs
    displayName: "Print infrastructure outputs"
    pool:
      vmImage: ubuntu-latest
    steps:
    - task: 6d15af64-176c-496d-b583-fd2ae21d4df4@1
      displayName: "Checkout repository"
      inputs:
        repository: self
    - task: CmdLine@2
      displayName: "Install Terraform $(terraformVersion)"
      inputs:
        script: |
          set -euo pipefail
          # Clear any leftovers in this temp directory. The step runs here, not in
          # the repo checkout, so `rm -rf terraform` cannot touch the Terraform code.
          rm -rf terraform terraform.zip tf_install
          curl -fsSL https://releases.hashicorp.com/terraform/$(terraformVersion)/terraform_$(terraformVersion)_linux_amd64.zip -o terraform.zip
          mkdir tf_install
          unzip -o terraform.zip -d tf_install
          sudo mv tf_install/terraform /usr/local/bin/terraform
          rm -rf tf_install terraform.zip
          terraform version
        workingDirectory: $(Agent.TempDirectory)
    - task: CmdLine@2
      displayName: "Terraform init (backend config)"
      env:
        AWS_ACCESS_KEY_ID: $(awsAccessKeyId)
        AWS_SECRET_ACCESS_KEY: [REDACTED]
        AWS_DEFAULT_REGION: $(awsDefaultRegion)
      inputs:
        script: |
          set -euo pipefail
          terraform init -input=false \
            -backend-config="bucket=$(tfStateBucket)" \
            -backend-config="key=$(tfStateKey)" \
            -backend-config="region=$(tfStateRegion)" \
            -backend-config="dynamodb_table=$(tfStateLockTable)"
        workingDirectory: terraform
    - task: CmdLine@2
      displayName: "Print outputs"
      env:
        AWS_ACCESS_KEY_ID: $(awsAccessKeyId)
        AWS_SECRET_ACCESS_KEY: [REDACTED]
        AWS_DEFAULT_REGION: $(awsDefaultRegion)
      inputs:
        script: |
          set -euo pipefail
          APP_PUBLIC_IP="$(terraform output -raw app_public_ip)"
          BACKEND_ANSIBLE_HOST="$(terraform output -raw backend_ansible_host)"
          BACKEND_PRIVATE_IP="$(terraform output -raw backend_private_ip)"
          MYSQL_FQDN="$(terraform output -raw mysql_fqdn)"
          echo "app_public_ip:        ${APP_PUBLIC_IP}"
          echo "backend_ansible_host: ${BACKEND_ANSIBLE_HOST}"
          echo "backend_private_ip:   ${BACKEND_PRIVATE_IP}"
          echo "mysql_fqdn:           ${MYSQL_FQDN}"
        workingDirectory: terraform


