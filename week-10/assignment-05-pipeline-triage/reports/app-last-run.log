Evaluating: value['script']
Result: 'set -euo pipefail
# Each job attempt publishes its own artifact (play-recap-<attempt>). Use the
# highest attempt, which is the one that succeeded.
RECAP_DIR=$(ls -d "$(Pipeline.Workspace)"/play-recap-* | sort -t- -k3,3n | tail -n 1)
[ -n "$RECAP_DIR" ] || { echo "##[error]No play-recap artifact found."; exit 1; }
echo "Reading $RECAP_DIR"
python3 -I - "$RECAP_DIR/play-recap.txt" "$(Build.SourcesDirectory)/$(ansibleInventory)" <<''PY''
import re
import sys

recap_path, inventory_path = sys.argv[1], sys.argv[2]


def fail(msg):
    print(f"##[error]{msg}")
    sys.exit(1)


# Expected hosts: every host in a non-vars inventory group. Also find the
# frontend''s public address for the browser check.
expected, frontend_ip, section = [], None, None
with open(inventory_path, encoding="utf-8") as fh:
    for raw in fh:
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("["):
            section = line.strip("[]")
            continue
        if section is None or section.endswith(":vars"):
            continue
        expected.append(line.split()[0])
        if section == "frontend":
            m = re.search(r"ansible_host=(\S+)", line)
            if m:
                frontend_ip = m.group(1)

# Parse the PLAY RECAP lines saved by Stage 3.
recap = {}
with open(recap_path, encoding="utf-8") as fh:
    for raw in fh:
        m = re.match(r"^(\S+)\s*:\s*(.*)$", raw.strip())
        if not m:
            continue
        stats = {k: int(v) for k, v in re.findall(r"(\w+)=(\d+)", m.group(2))}
        if "failed" in stats and "unreachable" in stats:
            recap[m.group(1)] = stats

if not recap:
    fail("No PLAY RECAP host lines found in the artifact. Stage 3 may not have run the playbook.")

missing = [h for h in expected if h not in recap]
if missing:
    fail("Inventory hosts missing from PLAY RECAP: " + ", ".join(missing))

bad = [h for h, s in recap.items() if s.get("failed", 0) or s.get("unreachable", 0)]
if bad:
    fail("Hosts with failed or unreachable results: " + ", ".join(bad))

print("Hosts touched by site.yml (from PLAY RECAP):")
for h in expected:
    s = recap[h]
    print(f"  {h}: ok={s.get(''ok'', 0)} changed={s.get(''changed'', 0)} "
          f"failed={s.get(''failed'', 0)} unreachable={s.get(''unreachable'', 0)}")

print(f"PLAY RECAP check passed: {len(expected)} of {len(expected)} hosts, 0 failed, 0 unreachable.")
print("The playbook''s own verification play (service, port, DB row counts, Nginx HTTP 200) ran in Stage 3.")
if frontend_ip:
    print(f"Manual browser check: http://{frontend_ip}/")
else:
    print("##[warning]Could not find the frontend ansible_host in the inventory. Check the URL by hand.")
PY
'
