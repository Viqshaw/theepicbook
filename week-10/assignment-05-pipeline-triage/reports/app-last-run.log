===== Step log 1 =====
trigger:
  branches:
    include:
    - main
  paths:
    include:
    - ansible/*
    - server.js
    - package.json
    - package-lock.json
    - routes/*
    - models/*
    - views/*
    - public/*
    - config/*
    - db/*
    - azure-pipelines.yml
pr:
  enabled: false
variables:
- group: Epicbook-mysql-secrets
- name: ansibleCoreSpec
  value: "ansible-core>=2.16,<2.19"
- name: ansibleInventory
  value: "ansible/inventory/hosts.ini"
- name: ansiblePlaybook
  value: "ansible/site.yml"
stages:
- stage: Prepare
  displayName: "Stage 1 - Prepare"
  jobs:
  - job: Prepare
    displayName: "Install Ansible and stage SSH key"
    pool:
      name: StaticSiteAgentPool
    steps:
    - task: 6d15af64-176c-496d-b583-fd2ae21d4df4@1
      displayName: "Checkout repository"
      inputs:
        repository: self
    - task: CmdLine@2
      displayName: "Install Ansible and community.mysql"
      inputs:
        script: |
          set -euo pipefail
          python3 --version
          sudo apt-get update -y
          sudo apt-get install -y python3-venv
          VENV="$(Agent.TempDirectory)/ansible-venv"
          rm -rf "$VENV"
          python3 -m venv "$VENV"
          "$VENV/bin/pip" install --quiet --upgrade pip
          "$VENV/bin/pip" install --quiet "$(ansibleCoreSpec)"
          # Collections come from ansible/requirements.yml (ansible.posix for the
          # backend synchronize task, ansible.mysql for the database tasks).
          "$VENV/bin/ansible-galaxy" collection install -r ansible/requirements.yml
          # Later steps in this job find ansible-playbook on PATH.
          echo "##vso[task.prependpath]$VENV/bin"
          "$VENV/bin/ansible" --version
    - task: DownloadSecureFile@1
      name: sshKey
      displayName: "Download SSH private key (Secure File)"
      inputs:
        secureFile: "id_ed25519"
    - task: CmdLine@2
      displayName: "Stage SSH key at a temp path (chmod 600)"
      inputs:
        script: |
          set -euo pipefail
          KEY_DIR="$(mktemp -d "$(Agent.TempDirectory)/ssh-key.XXXXXX")"
          chmod 700 "$KEY_DIR"
          mv "$(sshKey.secureFilePath)" "$KEY_DIR/id_ed25519"
          chmod 600 "$KEY_DIR/id_ed25519"
          test -s "$KEY_DIR/id_ed25519"
          echo "##vso[task.setvariable variable=SSH_KEY_PATH;issecret=[REDACTED]"
          echo "SSH key staged with mode $(stat -c '%a' "$KEY_DIR/id_ed25519"). Contents not shown."
    - task: CmdLine@2
      condition: always()
      displayName: "Remove temp SSH key"
      inputs:
        script: |
          find "$(Agent.TempDirectory)" -maxdepth 1 -name 'ssh-key.*' -exec rm -rf {} +
- stage: Validate
  displayName: "Stage 2 - Validate"
  dependsOn:
  - Prepare
  jobs:
  - job: Validate
    displayName: "Syntax checks and SSH connectivity"
    pool:
      name: StaticSiteAgentPool
    steps:
    - task: 6d15af64-176c-496d-b583-fd2ae21d4df4@1
      displayName: "Checkout repository"
      inputs:
        repository: self
    - task: CmdLine@2
      displayName: "Install Ansible and community.mysql"
      inputs:
        script: |
          set -euo pipefail
          sudo apt-get update -y
          sudo apt-get install -y python3-venv
          VENV="$(Agent.TempDirectory)/ansible-venv"
          rm -rf "$VENV"
          python3 -m venv "$VENV"
          "$VENV/bin/pip" install --quiet --upgrade pip
          "$VENV/bin/pip" install --quiet "$(ansibleCoreSpec)"
          "$VENV/bin/ansible-galaxy" collection install -r ansible/requirements.yml
          echo "##vso[task.prependpath]$VENV/bin"
          "$VENV/bin/ansible" --version
    - task: DownloadSecureFile@1
      name: sshKey
      displayName: "Download SSH private key (Secure File)"
      inputs:
        secureFile: "id_ed25519"
    - task: CmdLine@2
      displayName: "Stage SSH key at a temp path (chmod 600)"
      inputs:
        script: |
          set -euo pipefail
          KEY_DIR="$(mktemp -d "$(Agent.TempDirectory)/ssh-key.XXXXXX")"
          chmod 700 "$KEY_DIR"
          mv "$(sshKey.secureFilePath)" "$KEY_DIR/id_ed25519"
          chmod 600 "$KEY_DIR/id_ed25519"
          test -s "$KEY_DIR/id_ed25519"
          echo "##vso[task.setvariable variable=SSH_KEY_PATH;issecret=[REDACTED]"
          echo "SSH key staged with mode $(stat -c '%a' "$KEY_DIR/id_ed25519"). Contents not shown."
    - task: CmdLine@2
      displayName: "Validate inventory syntax (ansible-inventory --list)"
      inputs:
        script: |
          set -euo pipefail
          ansible-inventory -i "$(ansibleInventory)" --list > /dev/null
          echo "Inventory parsed successfully."
    - task: CmdLine@2
      displayName: "Validate playbook syntax (--syntax-check)"
      inputs:
        script: |
          set -euo pipefail
          # Diagnostic: which ansible-playbook runs, and whether the collections
          # from requirements.yml are visible to it.
          echo "ansible-playbook: $(command -v ansible-playbook)"
          ansible-config dump | grep COLLECTIONS_PATHS || true
          ansible-galaxy collection list || true
          ansible-playbook "$(ansiblePlaybook)" -i "$(ansibleInventory)" --syntax-check
    - task: CmdLine@2
      displayName: "Pin SSH host keys (bastion first, then the rest)"
      env:
        AGENT_NAME: $(Agent.Name)
        AGENT_MACHINE: $(Agent.MachineName)
        AGENT_HOME: $(Agent.HomeDirectory)
      inputs:
        script: |
          set -euo pipefail
          mkdir -p "$HOME/.ssh" && chmod 700 "$HOME/.ssh"
          SSH_OPTS=(-i "$(SSH_KEY_PATH)" -o StrictHostKeyChecking=accept-new -o BatchMode=yes -o ConnectTimeout=20)
          INV="$(ansibleInventory)"

          BASTION_IP="$(awk '$1 == "bastion_host" { for (i = 1; i <= NF; i++) if ($i ~ /^ansible_host=/) { sub(/^ansible_host=/, "", $i); print $i } }' "$INV")"
          [ -n "$BASTION_IP" ] || { echo "##[error]bastion_host ansible_host not found in inventory."; exit 1; }
          ssh "${SSH_OPTS[@]}" "ubuntu@$BASTION_IP" true

          while read -r name ip; do
            if [ "$name" = "backend_server" ]; then
              # Reached through the bastion, as set in the inventory's ansible_ssh_common_args.
              ssh "${SSH_OPTS[@]}" -J "ubuntu@$BASTION_IP" "ubuntu@$ip" true
            else
              ssh "${SSH_OPTS[@]}" "ubuntu@$ip" true
            fi
            echo "Host key pinned for $name."
          done < <(awk '/ansible_host=/ { for (i = 1; i <= NF; i++) if ($i ~ /^ansible_host=/) { sub(/^ansible_host=/, "", $i); print $1, $i } }' "$INV")
    - task: CmdLine@2
      displayName: "Verify actual pipeline inventory"
      inputs:
        script: |
          echo "===== CURRENT WORKING DIRECTORY ====="
          pwd

          echo "===== INVENTORY FILE ====="
          cat ansible/inventory/hosts.ini

          echo "===== RESOLVED BACKEND VARIABLES ====="
          ansible-inventory \
            -i ansible/inventory/hosts.ini \
            --host backend_server

          echo "===== SEARCH FOR OLD KEY ====="
          grep -Rni "/home/tonye/.ssh/id_ed25519" \
            . --exclude-dir=.git \
            --exclude-dir=.venv || true
    - task: CmdLine@2
      displayName: "SSH connectivity check (ansible all -m ping)"
      env:
        ANSIBLE_HOST_KEY_CHECKING: "False"
        ANSIBLE_NOCOLOR: "1"
      inputs:
        script: |
          set -euo pipefail

          eval "$(ssh-agent -s)" > /dev/null
          trap 'ssh-agent -k > /dev/null 2>&1 || true' EXIT
          ssh-add "$(SSH_KEY_PATH)" 2> /dev/null || {
            echo "##[error]ssh-add failed. Check that the key has no passphrase and is a valid private key."
            exit 1
          }

          set +e
          ansible -vvv -i "$(ansibleInventory)" all -m ping \
            --private-key "$(SSH_KEY_PATH)" \
            -e "ansible_ssh_private_key_file=$(SSH_KEY_PATH)"
          RC=$?
          set -e

          if [ "$RC" -ne 0 ]; then
            echo "##[error]SSH connectivity check FAILED (ansible exit code $RC). Ansible exit 4 means a host was unreachable and 2 means a host failed. Review the UNREACHABLE/FAILED lines above. backend_server is reached through bastion_host, so check both."
            exit "$RC"
          fi
          echo "Every inventory host answered the ping module."
    - task: CmdLine@2
      condition: always()
      displayName: "Remove temp SSH key"
      inputs:
        script: |
          find "$(Agent.TempDirectory)" -maxdepth 1 -name 'ssh-key.*' -exec rm -rf {} +
- stage: ConfigureAndDeploy
  displayName: "Stage 3 - Configure and Deploy"
  dependsOn:
  - Validate
  jobs:
  - job: ConfigureAndDeploy
    displayName: "Run site.yml"
    timeoutInMinutes: "60"
    pool:
      name: StaticSiteAgentPool
    steps:
    - task: 6d15af64-176c-496d-b583-fd2ae21d4df4@1
      displayName: "Checkout repository"
      inputs:
        repository: self
    - task: CmdLine@2
      displayName: "Install Ansible and community.mysql"
      inputs:
        script: |
          set -euo pipefail
          sudo apt-get update -y
          sudo apt-get install -y python3-venv
          VENV="$(Agent.TempDirectory)/ansible-venv"
          rm -rf "$VENV"
          python3 -m venv "$VENV"
          "$VENV/bin/pip" install --quiet --upgrade pip
          "$VENV/bin/pip" install --quiet "$(ansibleCoreSpec)"
          "$VENV/bin/ansible-galaxy" collection install -r ansible/requirements.yml
          echo "##vso[task.prependpath]$VENV/bin"
          "$VENV/bin/ansible-playbook" --version
    - task: DownloadSecureFile@1
      name: sshKey
      displayName: "Download SSH private key (Secure File)"
      inputs:
        secureFile: "id_ed25519"
    - task: CmdLine@2
      displayName: "Stage SSH key at a temp path (chmod 600)"
      inputs:
        script: |
          set -euo pipefail
          KEY_DIR="$(mktemp -d "$(Agent.TempDirectory)/ssh-key.XXXXXX")"
          chmod 700 "$KEY_DIR"
          mv "$(sshKey.secureFilePath)" "$KEY_DIR/id_ed25519"
          chmod 600 "$KEY_DIR/id_ed25519"
          test -s "$KEY_DIR/id_ed25519"
          echo "##vso[task.setvariable variable=SSH_KEY_PATH;issecret=[REDACTED]"
          echo "SSH key staged with mode $(stat -c '%a' "$KEY_DIR/id_ed25519"). Contents not shown."
    - task: CmdLine@2
      displayName: "Verify SSH connectivity"
      inputs:
        script: |
          set -euo pipefail

          echo "Agent user:"
          whoami

          echo "SSH key:"
          test -r "$(SSH_KEY_PATH)"
          echo "Secure File key is available"

          echo "Bastion connectivity:"
          ssh -F /dev/null \
            -i "$(SSH_KEY_PATH)" \
            -o IdentitiesOnly=yes \
            -o StrictHostKeyChecking=no \
            ubuntu@184.195.165.141 hostname

          echo "Backend connectivity through bastion:"
          ssh -F /dev/null \
            -i "$(SSH_KEY_PATH)" \
            -o IdentitiesOnly=yes \
            -o StrictHostKeyChecking=no \
            -o "ProxyCommand=ssh -F /dev/null -i $(SSH_KEY_PATH) -o IdentitiesOnly=yes -o StrictHostKeyChecking=no -W %h:%p ubuntu@184.195.165.141" \
            ubuntu@10.20.2.133 hostname
    - task: CmdLine@2
      displayName: "Install rsync"
      inputs:
        script: |
          sudo apt-get update
          sudo apt-get install -y rsync
    - task: CmdLine@2
      displayName: "Install Ansible collections"
      inputs:
        script: |
          ansible-galaxy collection install -r ansible/requirements.yml
    - task: CmdLine@2
      displayName: "Pin SSH host keys (bastion first, then the rest)"
      inputs:
        script: |
          set -euo pipefail
          mkdir -p "$HOME/.ssh" && chmod 700 "$HOME/.ssh"
          SSH_OPTS=(-i "$(SSH_KEY_PATH)" -o StrictHostKeyChecking=accept-new -o BatchMode=yes -o ConnectTimeout=20)
          INV="$(ansibleInventory)"

          BASTION_IP="$(awk '$1 == "bastion_host" { for (i = 1; i <= NF; i++) if ($i ~ /^ansible_host=/) { sub(/^ansible_host=/, "", $i); print $i } }' "$INV")"
          [ -n "$BASTION_IP" ] || { echo "##[error]bastion_host ansible_host not found in inventory."; exit 1; }
          ssh "${SSH_OPTS[@]}" "ubuntu@$BASTION_IP" true

          while read -r name ip; do
            if [ "$name" = "backend_server" ]; then
              ssh "${SSH_OPTS[@]}" -J "ubuntu@$BASTION_IP" "ubuntu@$ip" true
            else
              ssh "${SSH_OPTS[@]}" "ubuntu@$ip" true
            fi
            echo "Host key pinned for $name."
          done < <(awk '/ansible_host=/ { for (i = 1; i <= NF; i++) if ($i ~ /^ansible_host=/) { sub(/^ansible_host=/, "", $i); print $1, $i } }' "$INV")
    - task: CmdLine@2
      displayName: "Configure SSH for rsync through bastion"
      inputs:
        script: |
          set -euo pipefail
          mkdir -p "$HOME/.ssh"
          chmod 700 "$HOME/.ssh"

          {
            printf '%s\n' \
              "Host 184.195.165.141" \
              "    HostName 184.195.165.141" \
              "    User ubuntu" \
              "    IdentityFile $(SSH_KEY_PATH)" \
              "    IdentitiesOnly yes" \
              "    StrictHostKeyChecking no" \
              "" \
              "Host 10.20.2.133" \
              "    HostName 10.20.2.133" \
              "    User ubuntu" \
              "    IdentityFile $(SSH_KEY_PATH)" \
              "    IdentitiesOnly yes" \
              "    ProxyCommand ssh -F /dev/null -i $(SSH_KEY_PATH) -o IdentitiesOnly=yes -o StrictHostKeyChecking=no -W %h:%p ubuntu@184.195.165.141" \
              "    StrictHostKeyChecking no"
          } > "$HOME/.ssh/config"
          chmod 600 "$HOME/.ssh/config"

          echo "===== SSH CONFIGURATION ====="
          ssh -G 10.20.2.133 | grep -E '^(hostname|user|proxycommand|identityfile) '
    - task: CmdLine@2
      displayName: "Run site.yml (configure and deploy)"
      env:
        DB_ADMIN_USERNAME: $(mysqlAdminUsername)
        DB_ADMIN_PASSWORD: [REDACTED]
        ANSIBLE_HOST_KEY_CHECKING: "False"
        ANSIBLE_NOCOLOR: "1"
      inputs:
        script: |
          set -euo pipefail

          : "${DB_ADMIN_USERNAME:?mysqlAdminUsername is not set. Check the variable group.}"
          : "${DB_ADMIN_PASSWORD:[REDACTED] is not set. Check the variable group.}"

          RECAP_FILE="$(Agent.TempDirectory)/play-recap.txt"
          PLAY_LOG="$(Agent.TempDirectory)/site-run.log"
          EXTRA_VARS_FILE="$(mktemp "$(Agent.TempDirectory)/extra-vars.XXXXXX.json")"

          # Clean up on every exit path. Stop the ssh-agent and remove the secret
          # file and the run log. The recap file is kept for the publish step.
          trap 'rm -f "$EXTRA_VARS_FILE" "$PLAY_LOG"; ssh-agent -k > /dev/null 2>&1 || true' EXIT

          # Create the recap file up front so the publish step always has a file.
          touch "$RECAP_FILE"

          python3 -I - "$EXTRA_VARS_FILE" <<'PY'
          import json, os, sys
          payload = {
              "db_admin_username": os.environ["DB_ADMIN_USERNAME"],
              "db_admin_password": os.environ["DB_ADMIN_PASSWORD"],
          }
          with open(sys.argv[1], "w", encoding="utf-8") as fh:
              json.dump(payload, fh)
          PY

          # Load the key into an ssh-agent so the ProxyJump hop through
          # bastion-host can authenticate. See the Validate stage for details.
          eval "$(ssh-agent -s)" > /dev/null
          ssh-add "$(SSH_KEY_PATH)" 2> /dev/null || {
            echo "##[error]ssh-add failed. Check that the key has no passphrase and is a valid private key."
            exit 1
          }

          # Run the full playbook. tee streams it to the job log and to a file.
          # PIPESTATUS keeps the real ansible-playbook exit code. Only the
          # ansible-playbook exit code matters, and it is re-raised below.
          set +e
          ansible-playbook "$(ansiblePlaybook)" -i "$(ansibleInventory)" \
            --private-key "$(SSH_KEY_PATH)" \
            -e "ansible_ssh_private_key_file=$(SSH_KEY_PATH)" \
            -e "@$EXTRA_VARS_FILE" 2>&1 | tee "$PLAY_LOG"
          RC=${PIPESTATUS[0]}
          set -e

          # Keep only the PLAY RECAP host lines. Each has the form
          # "<host> : ok=N changed=N unreachable=N failed=N ...".
          grep -E '^[^[:space:]]+[[:space:]]*:[[:space:]]+ok=' "$PLAY_LOG" > "$RECAP_FILE" || true

          if [ ! -s "$RECAP_FILE" ]; then
            echo "##[error]No PLAY RECAP lines were captured. See the playbook output above."
            exit 1
          fi

          echo "site.yml finished with exit code $RC. PLAY RECAP saved for the Verify stage."
          exit "$RC"
    - task: PublishPipelineArtifact@1
      condition: always()
      displayName: "Publish PLAY RECAP artifact"
      inputs:
        targetPath: "$(Agent.TempDirectory)/play-recap.txt"
        artifact: "play-recap-$(System.JobAttempt)"
        publishLocation: "pipeline"
    - task: CmdLine@2
      condition: always()
      displayName: "Remove temp SSH key"
      inputs:
        script: |
          find "$(Agent.TempDirectory)" -maxdepth 1 -name 'ssh-key.*' -exec rm -rf {} +
- stage: Verify
  displayName: "Stage 4 - Verify"
  dependsOn:
  - ConfigureAndDeploy
  jobs:
  - job: Verify
    displayName: "Confirm play recap and summarize"
    pool:
      name: StaticSiteAgentPool
    steps:
    - task: 6d15af64-176c-496d-b583-fd2ae21d4df4@1
      displayName: "Checkout repository"
      inputs:
        repository: self
    - task: 30f35852-3f7e-4c0c-9a88-e127b4f97211@1
      displayName: "Download PLAY RECAP artifact from Stage 3"
      inputs:
        alias: current
    - task: CmdLine@2
      displayName: "Confirm PLAY RECAP (0 failed, 0 unreachable) and summarize"
      inputs:
        script: |
          set -euo pipefail
          # Each job attempt publishes its own artifact (play-recap-<attempt>). Use the
          # highest attempt, which is the one that succeeded.
          RECAP_DIR=$(ls -d "$(Pipeline.Workspace)"/play-recap-* | sort -t- -k3,3n | tail -n 1)
          [ -n "$RECAP_DIR" ] || { echo "##[error]No play-recap artifact found."; exit 1; }
          echo "Reading $RECAP_DIR"
          python3 -I - "$RECAP_DIR/play-recap.txt" "$(Build.SourcesDirectory)/$(ansibleInventory)" <<'PY'
          import re
          import sys

          recap_path, inventory_path = sys.argv[1], sys.argv[2]


          def fail(msg):
              print(f"##[error]{msg}")
              sys.exit(1)


          # Expected hosts: every host in a non-vars inventory group. Also find the
          # frontend's public address for the browser check.
          expected, frontend_ip, section = [], None, None
          with open(inventory_path, encoding="utf-8") as fh:
              for raw in fh:
                  line = raw.strip()
                  if not line or line.startswith("#"):
                      continue
                  if line.startswith("["):
                      section = line.strip("[]")
                      continue
                  if section is None or section.endswith(":vars"):
                      continue
                  expected.append(line.split()[0])
                  if section == "frontend":
                      m = re.search(r"ansible_host=(\S+)", line)
                      if m:
                          frontend_ip = m.group(1)

          # Parse the PLAY RECAP lines saved by Stage 3.
          recap = {}
          with open(recap_path, encoding="utf-8") as fh:
              for raw in fh:
                  m = re.match(r"^(\S+)\s*:\s*(.*)$", raw.strip())
                  if not m:
                      continue
                  stats = {k: int(v) for k, v in re.findall(r"(\w+)=(\d+)", m.group(2))}
                  if "failed" in stats and "unreachable" in stats:
                      recap[m.group(1)] = stats

          if not recap:
              fail("No PLAY RECAP host lines found in the artifact. Stage 3 may not have run the playbook.")

          missing = [h for h in expected if h not in recap]
          if missing:
              fail("Inventory hosts missing from PLAY RECAP: " + ", ".join(missing))

          bad = [h for h, s in recap.items() if s.get("failed", 0) or s.get("unreachable", 0)]
          if bad:
              fail("Hosts with failed or unreachable results: " + ", ".join(bad))

          print("Hosts touched by site.yml (from PLAY RECAP):")
          for h in expected:
              s = recap[h]
              print(f"  {h}: ok={s.get('ok', 0)} changed={s.get('changed', 0)} "
                    f"failed={s.get('failed', 0)} unreachable={s.get('unreachable', 0)}")

          print(f"PLAY RECAP check passed: {len(expected)} of {len(expected)} hosts, 0 failed, 0 unreachable.")
          print("The playbook's own verification play (service, port, DB row counts, Nginx HTTP 200) ran in Stage 3.")
          if frontend_ip:
              print(f"Manual browser check: http://{frontend_ip}/")
          else:
              print("##[warning]Could not find the frontend ansible_host in the inventory. Check the URL by hand.")
          PY


