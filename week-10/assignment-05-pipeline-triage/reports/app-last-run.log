Result: 'set -euo pipefail

: "${DB_ADMIN_USERNAME:?mysqlAdminUsername is not set. Check the variable group.}"
: "${DB_ADMIN_PASSWORD:[REDACTED] is not set. Check the variable group.}"

RECAP_FILE="$(Agent.TempDirectory)/play-recap.txt"
PLAY_LOG="$(Agent.TempDirectory)/site-run.log"
EXTRA_VARS_FILE="$(mktemp "$(Agent.TempDirectory)/extra-vars.XXXXXX.json")"

# Clean up on every exit path. Stop the ssh-agent and remove the secret
# file and the run log. The recap file is kept for the publish step.
trap ''rm -f "$EXTRA_VARS_FILE" "$PLAY_LOG"; ssh-agent -k > /dev/null 2>&1 || true'' EXIT

# Create the recap file up front so the publish step always has a file.
touch "$RECAP_FILE"

python3 -I - "$EXTRA_VARS_FILE" <<''PY''
import json, os, sys
payload = {
    "db_admin_username": os.environ["DB_ADMIN_USERNAME"],
    "db_admin_password": os.environ["DB_ADMIN_PASSWORD"],
}
with open(sys.argv[1], "w", encoding="utf-8") as fh:
    json.dump(payload, fh)
PY

# Load the key into an ssh-agent so the ProxyJump hop through
# bastion-host can authenticate. See the Validate stage for details.
eval "$(ssh-agent -s)" > /dev/null
ssh-add "$(SSH_KEY_PATH)" 2> /dev/null || {
  echo "##[error]ssh-add failed. Check that the key has no passphrase and is a valid private key."
  exit 1
}

# Run the full playbook. tee streams it to the job log and to a file.
# PIPESTATUS keeps the real ansible-playbook exit code. Only the
# ansible-playbook exit code matters, and it is re-raised below.
set +e
ansible-playbook "$(ansiblePlaybook)" -i "$(ansibleInventory)" \
  --private-key "$(SSH_KEY_PATH)" \
  -e "ansible_ssh_private_key_file=$(SSH_KEY_PATH)" \
  -e "@$EXTRA_VARS_FILE" 2>&1 | tee "$PLAY_LOG"
RC=${PIPESTATUS[0]}
set -e

# Keep only the PLAY RECAP host lines. Each has the form
# "<host> : ok=N changed=N unreachable=N failed=N ...".
grep -E ''^[^[:space:]]+[[:space:]]*:[[:space:]]+ok='' "$PLAY_LOG" > "$RECAP_FILE" || true

if [ ! -s "$RECAP_FILE" ]; then
  echo "##[error]No PLAY RECAP lines were captured. See the playbook output above."
  exit 1
fi

echo "site.yml finished with exit code $RC. PLAY RECAP saved for the Verify stage."
exit "$RC"
'
