Evaluating: value['script']
Result: 'set -euo pipefail
mkdir -p "$HOME/.ssh" && chmod 700 "$HOME/.ssh"
SSH_OPTS=(-i "$(SSH_KEY_PATH)" -o StrictHostKeyChecking=accept-new -o BatchMode=yes -o ConnectTimeout=20)
INV="$(ansibleInventory)"

BASTION_IP="$(awk ''$1 == "bastion_host" { for (i = 1; i <= NF; i++) if ($i ~ /^ansible_host=/) { sub(/^ansible_host=/, "", $i); print $i } }'' "$INV")"
[ -n "$BASTION_IP" ] || { echo "##[error]bastion_host ansible_host not found in inventory."; exit 1; }
ssh "${SSH_OPTS[@]}" "ubuntu@$BASTION_IP" true

while read -r name ip; do
  if [ "$name" = "backend_server" ]; then
    # Reached through the bastion, as set in the inventory''s ansible_ssh_common_args.
    ssh "${SSH_OPTS[@]}" -J "ubuntu@$BASTION_IP" "ubuntu@$ip" true
  else
    ssh "${SSH_OPTS[@]}" "ubuntu@$ip" true
  fi
  echo "Host key pinned for $name."
done < <(awk ''/ansible_host=/ { for (i = 1; i <= NF; i++) if ($i ~ /^ansible_host=/) { sub(/^ansible_host=/, "", $i); print $1, $i } }'' "$INV")
'
